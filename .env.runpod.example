# Copy this file to .env.runpod and keep the copy private.
RUNPOD_API_KEY=

# Pod configuration validated by the smoke run.
RUNPOD_GPU_ID="NVIDIA GeForce RTX 4090"
RUNPOD_CLOUD_TYPE=SECURE
RUNPOD_IMAGE=runpod/pytorch:1.0.2-cu1281-torch280-ubuntu2404
RUNPOD_CONTAINER_DISK_GB=20
RUNPOD_VOLUME_GB=50
RUNPOD_VOLUME_MOUNT_PATH=/workspace

# Cost safety. The Pod is stopped at the first deadline and deleted at the
# second even if the local launcher disappears.
RUNPOD_MAX_HOURS=4
RUNPOD_TERMINATE_AFTER_HOURS=24

# Optional placement controls (empty means any compatible location).
RUNPOD_COUNTRY_CODE=
RUNPOD_DATA_CENTER_IDS=

# Interactive confirmation is safer for humans. CI/automation may set true.
RUNPOD_AUTO_CONFIRM=false

# Successful runs delete the Pod after verified download. Failed runs are
# stopped and retained for diagnosis until the termination deadline.
RUNPOD_KEEP_POD=false
RUNPOD_DELETE_ON_FAILURE=false

# Usually discovered from `runpodctl pod get`; override only when necessary.
RUNPOD_SSH_KEY=
